{
  "expo": {
    "name": "attendance_tracker",
    "scheme": "xeratracker",
    "slug": "attendance_tracker",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/icons/icon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.xeramian.attendance_tracker"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1e681b6-bd7e-427c-85e6-1cd5b84e0521"
      }
    }
  }
}
